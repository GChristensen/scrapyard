# Scrapyard server configuration

# http or https; with https and without TLS_CERT/TLS_KEY a self-signed certificate is generated
SCHEME=https
# 127.0.0.1 behind a reverse proxy or `tailscale serve`, 0.0.0.0 to listen on all interfaces
HTTP_HOST=127.0.0.1
HTTP_PORT=20202
# directory with index.jsbk at its root
DATA_PATH=~/scrapyard
# the key entered in the Scrapyard add-on settings, generate it with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_KEY=

# optional settings
#TLS_CERT=/path/to/cert.pem
#TLS_KEY=/path/to/key.pem
#BACKUP_PATH=~/scrapyard/.backups
# set to 1 only when running behind a reverse proxy (Caddy, nginx, tailscale serve)
#TRUST_PROXY=0
# the number of worker threads, each WebSocket connection occupies one
#THREADS=32
# lifetime of archive links opened in browser tabs, 0 - links do not expire
#SIGNED_URL_TTL_HOURS=24
#LOG_FILE=/var/log/scrapyard/server.log
#LOG_LEVEL=INFO
